# Copy this file to .env and fill in real values before running
# `docker compose up` from infrastructure/, or before running the backend
# locally. Never commit the real .env file.

ENV=development
DEBUG=true

SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

DATABASE_URL=postgresql+psycopg2://resqlink:resqlink@postgres:5432/resqlink

REDIS_URL=redis://redis:6379/0

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

CORS_ORIGINS=["http://localhost","http://localhost:5173"]
